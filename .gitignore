# Android / Gradle - never commit these
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/local.properties
/android/captures/
/android/.cxx/

# Windows / other build outputs
/windows/flutter/generated_*.h
/windows/flutter/generated_*.cc

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
